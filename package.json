{
  "name": "ban-ban-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "server"],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite --host 0.0.0.0\" \"npm --workspace @banban/server run dev\"",
    "build": "tsc -b && npm --workspace @banban/server run typecheck && vite build",
    "typecheck": "tsc -b && npm --workspace @banban/server run typecheck",
    "test": "vitest run",
    "start": "npm --workspace @banban/server run start",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "concurrently": "^10.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}
