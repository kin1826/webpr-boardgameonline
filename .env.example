# Set NODE_ENV=production on the backend hosting service (dev defaults remain local).
# Backend listen address and port
HOST=0.0.0.0
PORT=3001

# Public frontend build-time setting (Vite embeds this in browser assets).
# Leave empty for same-origin dev/LAN or the single-process production server.
VITE_BACKEND_URL=

# Optional comma-separated browser origins for production; leave empty in local dev.
ALLOWED_ORIGINS=

# Session and cleanup policy
RECONNECT_GRACE_MS=90000
WAITING_ROOM_TTL_MS=1800000
MAX_ROOMS=2000
